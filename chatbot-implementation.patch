+
+  sendChat(): void {
+    const message = this.chatInput.trim();
+    if (!message) {
+      return;
+    }
+
+    this.chatMessages.push({ role: 'user', text: message });
+    this.chatInput = '';
+
+    const response = this.getChatResponse(message);
+    this.chatMessages.push({ role: 'assistant', text: response });
+  }
+
+  private getChatResponse(question: string): string {
+    const q = question.toLowerCase();
+    const overview = this.summaryOverview;
+    const keyPoints = this.summaryKeyPoints;
+    const takeaways = this.summaryTakeaways;
+
+    if (q.includes('key point') || q.includes('main point') || q.includes('important point')) {
+      return keyPoints.length
+        ? `Key points: ${keyPoints.join(' ')}`
+        : 'I do not have key point details for this document yet.';
+    }
+
+    if (q.includes('takeaway') || q.includes('what should i remember') || q.includes('remember')) {
+      return takeaways.length
+        ? `Important takeaways: ${takeaways.join(' ')}`
+        : 'I do not have takeaways for this document yet.';
+    }
+
+    if (q.includes('overview') || q.includes('summary') || q.includes('what is this document about')) {
+      return overview || 'This document does not have a summary available yet.';
+    }
+
+    if (q.includes('methodology') || q.includes('approach') || q.includes('how does')) {
+      return overview || 'I could not find a specific methodology section in the current summary.';
+    }
+
+    if (q.includes('application') || q.includes('real world') || q.includes('practice')) {
+      return overview || 'I could not find application details in the current summary.';
+    }
+
+    if (q.includes('conclusion') || q.includes('finding') || q.includes('result')) {
+      return overview || 'I could not locate a conclusion section in the current summary.';
+    }
+
+    return overview
+      ? `Here is what I found: ${overview}`
+      : 'I could not find an answer in the current summary. Try asking about key points or takeaways.';
+  }
